{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auris",
  "version": "0.0.1",
  "identifier": "org.auris.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "splash",
        "title": "Auris",
        "url": "index.html",
        "width": 420,
        "height": 320,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
